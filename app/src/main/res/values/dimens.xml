<?xml version="1.0" encoding="utf-8"?>
<!--
  统一骨架的尺寸。四个区（标题区、列表栏、内容区、动作栏）加一条状态条，
  所有界面都按这几个数排。

  list_width / corner_radius 已按极氪车机系统（Zeekr OS 2.1）的设置界面取值：
  左侧导航约占屏宽 16%，卡片圆角约 10dp。
-->
<resources>
    <dimen name="title_bar_height">64dp</dimen>
    <dimen name="status_bar_height">48dp</dimen>
    <dimen name="list_width">280dp</dimen>
    <dimen name="rail_width">380dp</dimen>
    <dimen name="corner_radius">10dp</dimen>
    <dimen name="gutter">12dp</dimen>

    <!-- 2.13 起照车机自带应用：设置卡片和左栏选中块的圆角都比按钮大一档 -->
    <dimen name="corner_radius_card">16dp</dimen>
    <dimen name="corner_radius_pill">14dp</dimen>

    <dimen name="rail_tile_height">104dp</dimen>
    <dimen name="rail_small_height">72dp</dimen>
    <dimen name="icon_button_size">48dp</dimen>

    <!-- 主界面压在画面上的操作层（layout_camera_controls） -->
    <dimen name="shutter_size">84dp</dimen>
    <dimen name="shutter_radius">42dp</dimen>
    <dimen name="shutter_ring_size">76dp</dimen>
    <dimen name="shutter_disc_size">56dp</dimen>
    <dimen name="round_button_size">56dp</dimen>
    <dimen name="round_button_radius">28dp</dimen>
    <dimen name="thumb_size">56dp</dimen>
    <dimen name="mode_chip_height">40dp</dimen>
    <dimen name="tools_panel_width">400dp</dimen>

    <!-- 回看：网格里一张缩略图的宽（16:9），下面那条胶片的高 -->
    <dimen name="gallery_tile_width">220dp</dimen>
    <dimen name="filmstrip_height">72dp</dimen>
    <dimen name="filmstrip_tile_width">128dp</dimen>
</resources>
