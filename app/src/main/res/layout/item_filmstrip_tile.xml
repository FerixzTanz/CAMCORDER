<?xml version="1.0" encoding="utf-8"?>
<!-- 查看器底下胶片上的一张：16:9 的小缩略图，正在看的那张描一圈能量橙；底下一行小字 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <FrameLayout
        android:id="@+id/strip_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_filmstrip_frame"
        android:padding="2dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/strip_image"
            android:layout_width="@dimen/filmstrip_tile_width"
            android:layout_height="@dimen/filmstrip_height"
            android:background="@color/sunken"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Cam.ThumbSmall" />
    </FrameLayout>

    <TextView
        android:id="@+id/strip_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textAppearance="@style/TextAppearance.Cam.Micro" />
</LinearLayout>
