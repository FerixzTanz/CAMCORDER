<?xml version="1.0" encoding="utf-8"?>
<!-- 回看网格的日期标题行：「今天  星期二」—— 日期大一档，星期几小一档、灰一级，横跨整行 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="true"
    android:gravity="bottom"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="18dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/gallery_header_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textAppearance="@style/TextAppearance.Cam.Row" />

    <TextView
        android:id="@+id/gallery_header_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="@color/text_secondary"
        android:textAppearance="@style/TextAppearance.Cam.Caption" />
</LinearLayout>
