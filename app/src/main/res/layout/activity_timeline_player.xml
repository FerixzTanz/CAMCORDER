<?xml version="1.0" encoding="utf-8"?>
<!--
  录像查看器 / 连续回放（2.13 起照车机自带相册的查看页排）。统一骨架：① 标题区 · ③ 内容区。

  ① 左起「‹ 返回」，中间这一条录制的说明，右侧一排方形图标键（详情 · 锁定此刻 ·
  发到手机 · 删除）和「全部录像」。② 列表栏没有了：挑哪一条在回看网格（GalleryActivity）
  里挑，这里底下一条胶片用来在相邻几条之间走。

  画面区和图片回看逐项对齐（图片回看又是照着主界面预览排的）：环视在左（权重 22），
  座舱竖排在右（权重 14），间距 @dimen/gutter，框是 bg_preview_frame 那张圆角底。
  这一条录制里没有文件的那一路整格收起来；座舱都没有时整列让开，环视独占整块。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/Widget.Cam.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/icon_button_size"
            android:text="@string/action_back"
            app:icon="@drawable/ic_back" />

        <!-- 这一条录制的说明（第几条、几点开始、几段、多长） -->
        <TextView
            android:id="@+id/timeline_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Cam.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pb_info"
            style="@style/Widget.Cam.IconButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:contentDescription="@string/action_info"
            app:icon="@drawable/ic_info" />

        <!-- 锁定此刻 / 解锁：此刻各路正在放的文件一起（锁定影像关着时收起） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/timeline_lock"
            style="@style/Widget.Cam.IconButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/action_lock_footage"
            android:visibility="gone"
            app:icon="@drawable/ic_lock_open" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/timeline_send"
            style="@style/Widget.Cam.IconButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/action_send_to_phone"
            app:icon="@drawable/ic_send_phone" />

        <!-- 删除这一条录制，不可逆：图标用录制红 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/pb_delete"
            style="@style/Widget.Cam.IconButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/action_delete_clip"
            app:icon="@drawable/ic_delete"
            app:iconTint="@color/recording" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_all"
            style="@style/Widget.Cam.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/icon_button_size"
            android:layout_marginStart="12dp"
            android:text="@string/action_all_videos" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 右：播放器 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/preview_background"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:padding="@dimen/gutter">

                    <!--
                      每一格：画面 + 遮罩 + 角标。

                      画面用 TextureView 而不是 VideoView：VideoView 内部是 SurfaceView，
                      会在窗口上挖一个洞，画面在洞后面合成 —— 小窗发虚/透明就是这么来的。

                      遮罩是一个不透明的普通 View，盖在画面上方：换分段时盖住上一段的
                      最后一帧，这一刻这一路没有录像时写一句话。不动 surface。
                    -->
                    <FrameLayout
                        android:id="@+id/frame_surround"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="22"
                        android:background="@drawable/bg_preview_frame">

                        <!-- 取景和鱼眼校正由外框画：校正是非线性的，TextureView 自己的矩阵做不到 -->
                        <com.kooo.evcam.playback.FisheyeVideoFrame
                            android:id="@+id/video_surround_frame"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <TextureView
                                android:id="@+id/video_surround"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />
                        </com.kooo.evcam.playback.FisheyeVideoFrame>

                        <TextView
                            android:id="@+id/cover_surround"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_preview_frame"
                            android:gravity="center"
                            android:textColor="@color/preview_placeholder_text"
                            android:textAppearance="@style/TextAppearance.Cam.Caption"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/label_surround"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_gravity="top|start"
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/camera_label_background"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textColor="@color/status_overlay_text"
                            android:textAppearance="@style/TextAppearance.Cam.Body" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/cabin_column"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/gutter"
                        android:layout_weight="14"
                        android:orientation="vertical">

                        <FrameLayout
                            android:id="@+id/frame_cabin_front"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_preview_frame">

                            <TextureView
                                android:id="@+id/video_cabin_front"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <TextView
                                android:id="@+id/cover_cabin_front"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_preview_frame"
                                android:gravity="center"
                                android:textColor="@color/preview_placeholder_text"
                                android:textAppearance="@style/TextAppearance.Cam.Caption"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/label_cabin_front"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:layout_gravity="top|start"
                                android:layout_marginStart="10dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/camera_label_background"
                                android:gravity="center"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:textColor="@color/status_overlay_text"
                                android:textAppearance="@style/TextAppearance.Cam.Body" />
                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/frame_cabin_rear"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="@dimen/gutter"
                            android:layout_weight="1"
                            android:background="@drawable/bg_preview_frame">

                            <TextureView
                                android:id="@+id/video_cabin_rear"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <TextView
                                android:id="@+id/cover_cabin_rear"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_preview_frame"
                                android:gravity="center"
                                android:textColor="@color/preview_placeholder_text"
                                android:textAppearance="@style/TextAppearance.Cam.Caption"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/label_cabin_rear"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:layout_gravity="top|start"
                                android:layout_marginStart="10dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/camera_label_background"
                                android:gravity="center"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:textColor="@color/status_overlay_text"
                                android:textAppearance="@style/TextAppearance.Cam.Body" />
                        </FrameLayout>

                        <!--
                          第四路在极氪 7X 上不存在，永远没有文件，于是永远不显示；
                          留着它是为自定义车型那种四面各一个相机的接法（图片回看也留着）。
                        -->
                        <FrameLayout
                            android:id="@+id/frame_fourth"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="@dimen/gutter"
                            android:layout_weight="1"
                            android:background="@drawable/bg_preview_frame"
                            android:visibility="gone">

                            <TextureView
                                android:id="@+id/video_fourth"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <TextView
                                android:id="@+id/cover_fourth"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_preview_frame"
                                android:gravity="center"
                                android:textColor="@color/preview_placeholder_text"
                                android:textAppearance="@style/TextAppearance.Cam.Caption"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/label_fourth"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:layout_gravity="top|start"
                                android:layout_marginStart="10dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/camera_label_background"
                                android:gravity="center"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:textColor="@color/status_overlay_text"
                                android:textAppearance="@style/TextAppearance.Cam.Body" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <!--
                  这里不放 ⑤ 状态条：它写的是现在的设置和 U 盘余量，不是这段录像的，
                  压在录像上会被当成这段录像的参数（项目拥有者 2026-10-01 定）。
                -->
            </FrameLayout>

            <!-- 进度条与控制 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg"
                android:orientation="vertical"
                android:padding="12dp">

                <SeekBar
                    android:id="@+id/timeline_seek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- 锁定的那几段：进度条正下方一条细条，只画不接触摸（锁定影像关着时收起） -->
                <com.kooo.evcam.ui.LockedRangeStrip
                    android:id="@+id/timeline_locked_strip"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/timeline_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_primary"
                    android:textAppearance="@style/TextAppearance.Cam.Body" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/timeline_prev_session"
                        style="@style/Widget.Cam.IconButton"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@string/player_prev"
                        app:icon="@drawable/ic_skip_prev" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/timeline_play_pause"
                        style="@style/Widget.Cam.IconButton"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@string/action_play"
                        app:icon="@drawable/ic_play" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/timeline_next_session"
                        style="@style/Widget.Cam.IconButton"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@string/player_next"
                        app:icon="@drawable/ic_skip_next" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/timeline_speed"
                        style="@style/Widget.Cam.RailSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_marginEnd="8dp"
                        android:minWidth="72dp"
                        android:text="1.0x" />

                    <!-- 和图片回看底部那个同一个按钮：网格 → 有录像的每一路 → 回到网格 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/timeline_view_mode"
                        style="@style/Widget.Cam.RailSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_marginEnd="8dp"
                        android:minWidth="96dp"
                        android:text="@string/photo_mode_multi"
                        app:icon="@drawable/ic_grid" />

                    <!-- 保存片段（2.10.8）：此刻前后各 15 秒抄成一个普通 MP4，存到 EVCam_Clips，然后可以发到手机。
                         选段时按钮上的字会变成「保存到此处」，所以它是带字的，不进标题区那排图标 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/timeline_save_clip"
                        style="@style/Widget.Cam.RailSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_marginEnd="12dp"
                        android:text="@string/action_save_clip"
                        app:icon="@drawable/ic_clip" />

                    <!-- 胶片：一条条录制，正在放的那条描一圈橙 -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/timeline_session_list"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
