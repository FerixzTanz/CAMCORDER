<?xml version="1.0" encoding="utf-8"?>
<!--
  照片查看器（2.13 起照车机自带相册的查看页排）。统一骨架：① 标题区 · ③ 内容区。

  ① 左起「‹ 返回」，中间这一组的拍摄时间，右侧一排方形图标键（详情 · 锁定 · 分享 ·
  发到手机 · 删除）和「全部照片」。② 列表栏没有了：挑哪一组在回看网格（GalleryActivity）
  里挑，这里底下一条胶片用来在相邻几组之间走。

  画面区和主界面预览逐项对齐：环视在左（权重 22），两路座舱竖排在右（权重 14）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- ① 标题区 -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/Widget.Cam.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/icon_button_size"
            android:text="@string/action_back"
            app:icon="@drawable/ic_back" />

        <TextView
            android:id="@+id/current_datetime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Cam.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pb_info"
            style="@style/Widget.Cam.IconButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:contentDescription="@string/action_info"
            app:icon="@drawable/ic_info" />

        <!-- 锁定 / 解锁这一组（锁定影像关着时收起） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/pb_lock"
            style="@style/Widget.Cam.IconButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/action_lock_footage"
            android:visibility="gone"
            app:icon="@drawable/ic_lock_open" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pb_share"
            style="@style/Widget.Cam.IconButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/action_share"
            app:icon="@drawable/ic_share" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pb_send"
            style="@style/Widget.Cam.IconButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/action_send_to_phone"
            app:icon="@drawable/ic_send_phone" />

        <!-- 删除不可逆：图标用录制红 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/pb_delete"
            style="@style/Widget.Cam.IconButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/action_delete"
            app:icon="@drawable/ic_delete"
            app:iconTint="@color/recording" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_all"
            style="@style/Widget.Cam.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/icon_button_size"
            android:layout_marginStart="12dp"
            android:text="@string/action_all_photos" />
    </LinearLayout>

    <!-- ③ 内容区 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter">

        <!--
          多路：有文件才显示 —— 同一个时间戳下没拍到的那一格整个收起来，
          不留空框（见 updatePhotoDisplay）。两路座舱都没有时整列让开，
          环视独占整块。第四路（right）在极氪 7X 上不存在，永远没有文件，
          于是永远不显示；留着它是为自定义车型那种四面各一个相机的接法。
        -->
        <LinearLayout
            android:id="@+id/multi_view_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/frame_front"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="22"
                android:background="@drawable/bg_preview_frame">

                <ImageView
                    android:id="@+id/image_front"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/label_front"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/camera_label_background"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/zeekr_lane_front"
                    android:textColor="@color/status_overlay_text"
                    android:textAppearance="@style/TextAppearance.Cam.Body" />

                <TextView
                    android:id="@+id/placeholder_front"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/photo_no_image"
                    android:textColor="@color/preview_placeholder_text"
                    android:textAppearance="@style/TextAppearance.Cam.Caption"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/cabin_column"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/gutter"
                android:layout_weight="14"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/frame_back"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_preview_frame">

                    <ImageView
                        android:id="@+id/image_back"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/label_back"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/camera_label_background"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/zeekr_lane_back"
                        android:textColor="@color/status_overlay_text"
                        android:textAppearance="@style/TextAppearance.Cam.Body" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/frame_left"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/gutter"
                    android:layout_weight="1"
                    android:background="@drawable/bg_preview_frame">

                    <ImageView
                        android:id="@+id/image_left"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/label_left"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/camera_label_background"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/zeekr_lane_left"
                        android:textColor="@color/status_overlay_text"
                        android:textAppearance="@style/TextAppearance.Cam.Body" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/frame_right"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/gutter"
                    android:layout_weight="1"
                    android:background="@drawable/bg_preview_frame"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/image_right"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/label_right"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/camera_label_background"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/zeekr_lane_right"
                        android:textColor="@color/status_overlay_text"
                        android:textAppearance="@style/TextAppearance.Cam.Body" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 没有照片时 -->
        <TextView
            android:id="@+id/empty_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/photo_empty"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Cam.Row"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 底部：看哪一路 + 胶片 -->
    <LinearLayout
        android:id="@+id/controls_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/gutter"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/gutter"
        android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_view_mode"
            style="@style/Widget.Cam.RailSmall"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginEnd="12dp"
            android:minWidth="96dp"
            android:text="@string/photo_mode_multi"
            app:icon="@drawable/ic_grid" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/photo_list"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />
    </LinearLayout>
</LinearLayout>
