<?xml version="1.0" encoding="utf-8"?>
<!--
  分段开关里的一段（照车机自带设置）：选中的那一段是一块卡片底色加一圈能量橙描边，
  其余透明 —— 不再是实心橙块，字也就不用反白。
  选中状态用 activated，不用 selected：selected 在列表里另有含义（整行被选）。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card" />
            <stroke android:width="2dp" android:color="@color/energy" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="2dp" android:color="@android:color/transparent" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</selector>
